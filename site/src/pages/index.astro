---
import Site from "../layouts/Site.astro";
import { META, r2 } from "../lib/format";
---
<Site title="Federal Money Atlas" description={`For every $1 a county's residents pay in federal taxes, how much federal money comes back? The typical county gets ${r2(META.median_ratio)}. Explore all 3,144 counties.`} page="home">
  <div class="grid"><div class="cell s8 white"><p class="label">Fiscal year {META.fiscal_year} · 3,144 counties</p><h1 class="hero">What does $1 get you?</h1>
    <p class="lead">For every $1 a county's residents pay in federal taxes, see how much federal money comes back — Social Security, grants and contracts.</p>
    <p class="btnrow"><a class="btn primary" href="/map/">Show the map</a><a class="btn" href="/counties/">Browse counties</a></p></div>
    <div class="cell s4 green"><p class="label" style="color:var(--ink)">The typical county gets back</p><p class="giant">{r2(META.median_ratio)}</p></div></div>
</Site>

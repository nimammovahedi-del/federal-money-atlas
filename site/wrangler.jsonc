// Cloudflare Workers settings for the static site (built by `npm run build` into ./dist).
{
  "name": "federal-money-atlas",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // serve dist/404.html (with a 404 status) for unknown addresses
    "not_found_handling": "404-page",
    // /map and /map/ both work; canonical form has the trailing slash
    "html_handling": "auto-trailing-slash"
  }
}
